KNOWLEDGE_DEMO_PASSWORD=
KNOWLEDGE_PORT=4310
# Optional absolute path. Defaults to the repository's .artifacts/company-agent/pgdata.
KNOWLEDGE_DATA_DIR=

# demo: local excerpts with citations, no network or API key. openai: approved compatible API.
KNOWLEDGE_MODEL_MODE=demo
KNOWLEDGE_MODEL_BASE_URL=
KNOWLEDGE_MODEL_NAME=
KNOWLEDGE_MODEL_API_KEY=
KNOWLEDGE_MODEL_TIMEOUT_MS=60000
KNOWLEDGE_MODEL_MAX_TOKENS=2048
# Some gateways require max_completion_tokens or do not support stream_options.include_usage.
KNOWLEDGE_MODEL_MAX_TOKENS_FIELD=max_tokens
KNOWLEDGE_MODEL_STREAM_USAGE=true

# Python 3.12 environment with parser/requirements.txt installed.
KNOWLEDGE_PYTHON_PATH=
KNOWLEDGE_OCR_MODE=auto
KNOWLEDGE_PARSE_TIMEOUT_MS=300000
KNOWLEDGE_MAX_DOCUMENT_PAGES=120
# Optional: full path to soffice executable, only required for legacy .doc files.
KNOWLEDGE_LIBREOFFICE_PATH=
